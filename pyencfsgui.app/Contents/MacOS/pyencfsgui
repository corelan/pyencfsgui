#!/bin/zsh

set -e

BUNDLE_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
REPO_DIR="$(cd "$BUNDLE_ROOT/.." && pwd)"
VENV_DIR="$REPO_DIR/pyencfsgui-venv"
PYTHON_BIN="${PYTHON:-python3}"

cd "$REPO_DIR"

if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	if ! git pull; then
		printf '%s\n' "Warning: git pull failed; starting pyencfsgui with the existing files."
	fi
else
	printf '%s\n' "Warning: git is unavailable or this folder is not a Git checkout; skipping update."
fi

if [ ! -x "$VENV_DIR/bin/python" ]; then
	"$PYTHON_BIN" -m venv "$VENV_DIR"
fi

"$VENV_DIR/bin/python" -m ensurepip --upgrade >/dev/null 2>&1 || true

if ! "$VENV_DIR/bin/python" -c 'import PyQt5; from crypto_compat import AES' >/dev/null 2>&1; then
	"$VENV_DIR/bin/python" -m pip install --disable-pip-version-check --quiet -r "$REPO_DIR/requirements.txt"
fi

source "$VENV_DIR/bin/activate"
nohup "$VENV_DIR/bin/python" "$REPO_DIR/encfsgui.py" >/tmp/pyencfsgui-launcher.log 2>&1 &
exit 0
